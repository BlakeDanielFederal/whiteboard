{
  "name": "remote-guard-probe",
  "displayName": "Remote guard probe",
  "version": "0.0.1",
  "private": true,
  "description": "Test only. Attempts each action the guard must block, and records the outcome.",
  "publisher": "wb-test",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wbProbe.run",
        "title": "Run the remote guard probe again"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.quickOpen",
        "args": "wbprobekeybinding",
        "key": "ctrl+shift+alt+y",
        "mac": "cmd+shift+alt+y"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "wbProbe.run",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "wbprobelang",
        "aliases": [
          "WB Probe"
        ],
        "extensions": [
          ".wbprobe"
        ]
      }
    ],
    "grammars": [
      {
        "language": "wbprobelang",
        "scopeName": "source.wbprobe",
        "path": "./wbprobe.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "*"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "enabledApiProposals": [
    "findTextInFiles"
  ]
}
